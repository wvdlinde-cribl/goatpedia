{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wvdlinde-cribl.github.io/secpedia/schema/entry.schema.json",
  "title": "Secpedia entry",
  "description": "One security device or software that produces logs. Stubs need only the basics; status: full requires every section.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "short", "vendor", "category", "status", "summary", "sourcetypes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must equal the file name without .yaml" },
    "name": { "type": "string", "minLength": 2 },
    "short": { "type": "string", "maxLength": 14, "description": "Badge label used in diagrams" },
    "aka": { "type": "array", "items": { "type": "string" } },
    "vendor": { "type": "string" },
    "category": { "type": "string", "description": "Key from categories.yaml" },
    "status": { "enum": ["stub", "full"] },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "contributors": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 20 },
    "sourcetypes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["st"],
        "properties": { "st": { "type": "string" }, "desc": { "type": "string" } } }
    },
    "cveIds": { "type": "array", "items": { "$ref": "#/definitions/cveId" }, "description": "Stubs only: bare CVE list" },
    "facts": { "type": "object", "additionalProperties": { "type": "string" } },
    "placement": {
      "type": "object", "required": ["items"],
      "properties": {
        "slots": { "type": "array", "items": { "$ref": "#/definitions/slot" } },
        "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["slot", "title", "desc"],
          "properties": { "slot": { "$ref": "#/definitions/slot" }, "title": { "type": "string" }, "desc": { "type": "string" } } } }
      }
    },
    "howItWorks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/titleBody" } },
    "traffic": {
      "type": "object", "required": ["handles", "flow"],
      "properties": {
        "handles": { "type": "array", "items": { "type": "string" } },
        "flow": { "type": "array", "items": { "type": "object", "required": ["step", "desc"],
          "properties": { "step": { "type": "string" }, "desc": { "type": "string" } } } }
      }
    },
    "logs": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["type", "sourcetype", "format", "desc", "fields", "sample"],
        "properties": {
          "type": { "type": "string" }, "sourcetype": { "type": "string" },
          "format": { "enum": ["csv"], "description": "Only CSV samples are annotated today; kv/json/cef are planned" },
          "share": { "type": "string" }, "avg": { "type": "string" }, "desc": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } },
          "key": { "type": "array", "items": { "type": "string" } },
          "noise": { "type": "array", "items": { "type": "string" } },
          "sample": { "type": "string" }
        } }
    },
    "cves": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "cvss", "title", "scope", "affected", "detect", "avoid"],
        "properties": {
          "id": { "$ref": "#/definitions/cveId" }, "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
          "year": { "type": "integer" }, "kev": { "type": "boolean" }, "scope": { "enum": ["device", "traffic"] },
          "title": { "type": "string" }, "affected": { "type": "string" }, "fixed": { "type": "string" },
          "detect": { "type": "string", "description": "How to identify it in this device's logs" },
          "avoid": { "type": "string", "description": "Signals / controls to avoid or mitigate it" }
        } }
    },
    "detections": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "severity", "signals", "why", "kql"],
        "properties": {
          "title": { "type": "string" }, "severity": { "enum": ["critical", "high", "medium", "low"] },
          "signals": { "type": "array", "items": { "type": "string" } }, "why": { "type": "string" }, "kql": { "type": "string" }
        } }
    },
    "optimizations": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "saving", "fn", "how"],
        "properties": { "title": { "type": "string" }, "saving": { "type": "string" }, "fn": { "type": "string" },
          "how": { "type": "string" }, "expr": { "type": "string" } } }
    },
    "related": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "properties": { "status": { "const": "full" } } },
  "then": { "required": ["aka", "updated", "facts", "placement", "howItWorks", "traffic", "logs", "cves", "detections", "optimizations"] },
  "definitions": {
    "cveId": { "type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$" },
    "slot": { "enum": ["edge", "internal", "cloud", "remote", "dmz", "endpoint"] },
    "titleBody": { "type": "object", "required": ["title", "body"], "properties": { "title": { "type": "string" }, "body": { "type": "string" } } }
  }
}
