{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wvdlinde-cribl.github.io/goatpedia/schema/entry.schema.json",
  "title": "Goatpedia entry",
  "description": "One security device or software that produces logs. Stubs need only the basics; status: full requires every section.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "short", "vendor", "category", "status", "summary", "sourcetypes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must equal the file name without .yaml" },
    "name": { "type": "string", "minLength": 2 },
    "short": { "type": "string", "maxLength": 14, "description": "Badge label used in diagrams" },
    "aka": { "type": "array", "items": { "type": "string" } },
    "vendor": { "type": "string" },
    "category": { "type": "string", "description": "Key from categories.yaml" },
    "status": { "enum": ["stub", "full"] },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "contributors": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "minLength": 20 },
    "sourcetypes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["st"],
        "properties": { "st": { "type": "string" }, "desc": { "type": "string" } } }
    },
    "cveIds": { "type": "array", "items": { "$ref": "#/definitions/cveId" }, "description": "Stubs only: bare CVE list" },
    "facts": { "type": "object", "additionalProperties": { "type": "string" } },
    "placement": {
      "type": "object", "required": ["items"],
      "properties": {
        "slots": { "type": "array", "items": { "$ref": "#/definitions/slot" } },
        "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["slot", "title", "desc"],
          "properties": { "slot": { "$ref": "#/definitions/slot" }, "title": { "type": "string" }, "desc": { "type": "string" } } } }
      }
    },
    "howItWorks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/titleBody" } },
    "traffic": {
      "type": "object", "required": ["handles", "flow"],
      "properties": {
        "handles": { "type": "array", "items": { "type": "string" } },
        "flow": { "type": "array", "items": { "type": "object", "required": ["step", "desc"],
          "properties": { "step": { "type": "string" }, "desc": { "type": "string" } } } }
      }
    },
    "logs": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["type", "sourcetype", "format", "desc", "sample"],
        "properties": {
          "type": { "type": "string" }, "sourcetype": { "type": "string" },
          "format": { "enum": ["csv", "tsv", "kv", "json", "cef", "leef", "xml", "text"], "description": "csv/tsv need `fields`; text needs `pattern`; the others are parsed from the sample itself" },
          "share": { "type": "string" }, "avg": { "type": "string" }, "desc": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" }, "description": "Column names (csv/tsv only)" },
          "pattern": { "type": "string", "description": "format text: JavaScript regex with named groups that matches the sample" },
          "key": { "type": "array", "items": { "type": "string" } },
          "noise": { "type": "array", "items": { "type": "string" } },
          "sample": { "type": "string" }
        } }
    },
    "cves": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "cvss", "title", "scope", "affected", "detect", "avoid"],
        "properties": {
          "id": { "$ref": "#/definitions/cveId" }, "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
          "year": { "type": "integer" }, "kev": { "type": "boolean" }, "scope": { "enum": ["device", "traffic"] },
          "title": { "type": "string" }, "affected": { "type": "string" }, "fixed": { "type": "string" },
          "detect": { "type": "string", "description": "How to identify it in this device's logs" },
          "avoid": { "type": "string", "description": "Signals / controls to avoid or mitigate it" }
        } }
    },
    "detections": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "severity", "signals", "why", "kql"],
        "properties": {
          "title": { "type": "string" }, "severity": { "enum": ["critical", "high", "medium", "low"] },
          "signals": { "type": "array", "items": { "type": "string" } }, "why": { "type": "string" }, "kql": { "type": "string" },
          "mitre": { "type": "array", "items": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" }, "description": "MITRE ATT&CK technique ids" }
        } }
    },
    "references": {
      "type": "array", "description": "Vendor documentation and advisories the article is based on",
      "items": { "type": "object", "required": ["title", "url"], "additionalProperties": false,
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } } }
    },
    "optimizations": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "saving", "fn", "how"],
        "properties": { "title": { "type": "string" }, "saving": { "type": "string" }, "fn": { "type": "string" },
          "how": { "type": "string" }, "expr": { "type": "string" },
          "stream": { "$ref": "#/definitions/stream" } } }
    },
    "related": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "properties": { "status": { "const": "full" } } },
  "then": { "required": ["aka", "updated", "facts", "placement", "howItWorks", "traffic", "logs", "cves", "detections", "optimizations", "references"] },
  "definitions": {
    "cveId": { "type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$" },
    "streamFunction": { "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "description": "Cribl Stream function id: serde, eval, drop, suppress, aggregation, sampling, …" },
        "filter": { "type": "string", "description": "ES5 JavaScript filter expression; default true" },
        "description": { "type": "string" }, "final": { "type": "boolean" },
        "conf": { "type": "object", "description": "The function's configuration, exactly as Cribl Stream stores it" } } },
    "stream": { "type": "object", "additionalProperties": false,
      "description": "Exact Cribl Stream functions for an optimization: site/stream.js adds the parse (and serialize) steps; scripts/stream-verify.mjs checks it in Cribl's preview",
      "properties": {
        "log": { "type": "string", "description": "The logs[].type this works on; its format and fields give the parse step" },
        "parse": { "type": "boolean", "description": "false skips the generated parse step" },
        "functions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/streamFunction" } },
        "serialize": { "type": "boolean", "description": "Write the event back in the log's original format afterwards" },
        "routes": { "type": "array", "items": { "type": "object", "required": ["name", "filter", "to"], "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "filter": { "type": "string" }, "to": { "type": "string" }, "final": { "type": "boolean" } } } },
        "note": { "type": "string", "description": "How to apply advice that is not a pipeline function (source settings, routes)" },
        "test": { "type": "array", "items": { "type": "string" }, "description": "Extra synthetic raw events for the Cribl check" },
        "expect": { "type": "object", "additionalProperties": false,
          "properties": { "out": { "type": "integer", "minimum": 0 }, "outMin": { "type": "integer", "minimum": 0 }, "outMax": { "type": "integer", "minimum": 0 }, "absent": { "type": "array", "items": { "type": "string" } },
            "present": { "type": "array", "items": { "type": "string" } }, "smaller": { "type": "boolean" } } } } },
    "slot": { "enum": ["edge", "internal", "cloud", "remote", "dmz", "endpoint"] },
    "titleBody": { "type": "object", "required": ["title", "body"], "properties": { "title": { "type": "string" }, "body": { "type": "string" } } }
  }
}
